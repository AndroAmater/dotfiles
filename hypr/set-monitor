#!/bin/sh

set -eu

if [ "$#" -ne 5 ]; then
    printf 'usage: %s NAME MODE POSITION SCALE TRANSFORM\n' "$0" >&2
    exit 2
fi

name=$1
mode=$2
position=$3
scale=$4
transform=$5
config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/hypr
config=$config_dir/monitors.conf
lock=${XDG_RUNTIME_DIR:-/tmp}/dotfiles-hypr-monitor.lock
spec="$name,$mode,$position,$scale,transform,$transform"

(
    flock 9
    tmp=$(mktemp "$config.XXXXXX")
    trap 'rm -f "$tmp"' EXIT HUP INT TERM

    hyprctl keyword monitor "$spec"

    if [ -f "$config" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                "monitor = $name,"*) ;;
                *) printf '%s\n' "$line" >> "$tmp" ;;
            esac
        done < "$config"
    fi

    printf 'monitor = %s\n' "$spec" >> "$tmp"
    mv "$tmp" "$config"
    trap - EXIT HUP INT TERM
) 9> "$lock"
